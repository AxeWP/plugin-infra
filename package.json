{
	"name": "@axepress/plugin-infra",
	"version": "0.2.1",
	"description": "Shareable base configs for AxeWP WordPress plugins.",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/AxeWP/plugin-infra#readme",
	"bugs": "https://github.com/AxeWP/plugin-infra/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AxeWP/plugin-infra.git"
	},
	"type": "module",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"configs",
		"examples",
		"README.md",
		"LICENSE.md"
	],
	"exports": {
		"./prettier": "./configs/prettier.mjs",
		"./tsconfig": "./configs/tsconfig.json",
		"./eslint": "./configs/eslint.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"peerDependencies": {
		"@wordpress/eslint-plugin": ">=27.0.0",
		"@wordpress/prettier-config": ">=4.0.0",
		"eslint": ">=9.0.0",
		"prettier": "npm:wp-prettier@>=3",
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/eslint-plugin": {
			"optional": true
		},
		"@wordpress/prettier-config": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"prettier": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/json": "^2.1.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/prettier-config": "^4.56.0",
		"eslint": "^9.39.5",
		"lefthook": "^2.1.14",
		"lint-staged": "^17.6.0",
		"prettier": "npm:wp-prettier@>=3",
		"string-argv": "^0.3.2"
	},
	"overrides": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"prettier": "npm:wp-prettier@>=3"
	},
	"allowScripts": {
		"lefthook@2.1.14": true,
		"unrs-resolver@1.12.2": true
	}
}
